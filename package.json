{
  "name": "nodemon",
  "version": "1.0.0",
  "main": "server.ts",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "concurrently": "^9.2.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "copy:client-types": "mkdir -p static/types && cp types/quotes.ts static/types/quotes.ts",
    "prestart": "npm run copy:client-types",
    "start": "tsx --watch server.ts",
    "prestart:dev": "npm run copy:client-types",
    "start:dev": "concurrently -k -n server,client \"tsx --watch server.ts\" \"tsc -p tsconfig.client.json --watch\"",
    "prebuild": "npm run copy:client-types",
    "build": "tsc -p tsconfig.client.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:client": "tsc --noEmit -p tsconfig.client.json",
    "seed:cars": "tsx data/cars/seedCars.ts",
    "seed:students": "tsx data/students/seedStudents.ts",
    "seed:jokes": "tsx data/seedJokes.ts"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": "24.20.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "mongodb": "^7.6.0",
    "yarn": "^1.22.22"
  }
}
